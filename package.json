{
	"name": "pi-knowledge",
	"version": "0.9.0",
	"description": "Local-first RAG knowledge base for Pi and OMP coding agents with hybrid code/doc search, reranking, diagnostics, and large-project indexing",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"pi": {
		"extensions": [
			"./extension.js"
		]
	},
	"files": [
		"extension.js",
		"dist/",
		".pi/",
		"docs/configuration.md",
		"docs/offline-mode.md",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"omp",
		"omp-sh",
		"ai-agent",
		"coding-agent",
		"knowledge-base",
		"local-first",
		"retrieval-augmented-generation",
		"hybrid-search",
		"bm25",
		"vector-search",
		"semantic-search",
		"code-search",
		"developer-tools",
		"rag",
		"embeddings"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "biome check --write --error-on-warnings .",
		"prepack": "npm run typecheck && npm run build",
		"test": "vitest --run test/unit/",
		"test:e2e": "vitest --run test/e2e/",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"bench": "vitest bench test/bench/"
	},
	"dependencies": {
		"@huggingface/transformers": "3.8.1",
		"better-sqlite3": "12.11.1",
		"ignore": "7.0.5",
		"mammoth": "1.12.0",
		"tree-sitter": "0.25.1",
		"tree-sitter-bash": "0.25.1",
		"tree-sitter-c": "0.24.1",
		"tree-sitter-cpp": "0.23.4",
		"tree-sitter-go": "0.25.0",
		"tree-sitter-java": "0.23.5",
		"tree-sitter-javascript": "0.25.0",
		"tree-sitter-python": "0.25.0",
		"tree-sitter-qmljs": "0.3.1",
		"tree-sitter-rust": "0.24.0",
		"tree-sitter-typescript": "0.23.2",
		"unpdf": "1.6.2"
	},
	"overrides": {
		"tree-sitter": "0.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nczz/pi-knowledge.git"
	}
}
